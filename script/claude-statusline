#!/usr/bin/env bash
# Claude Code status line: maps its stdin JSON into the shape lib/statusline.sh renders.

source "$(dirname "${BASH_SOURCE[0]}")/lib/statusline.sh"

# Rate limits: five_hour -> S, seven_day -> W. Claude reports resets_at as an epoch,
# so convert it to seconds until reset.
# shellcheck disable=SC2016  # $now etc. are jq variables, not shell
statusline_main '
  def until_reset: if . == null then null else . - $now end;
  {
    model: (.model.display_name // "Claude"),
    effort: .effort.level,
    short_pct: .rate_limits.five_hour.used_percentage,
    short_reset: (.rate_limits.five_hour.resets_at | until_reset),
    week_pct: .rate_limits.seven_day.used_percentage,
    week_reset: (.rate_limits.seven_day.resets_at | until_reset)
  }
'
