#!/bin/bash

# Bootstrap script for new machines
# Usage: curl -fsSL <raw-url>/bootstrap | bash
# Clones dotfiles repo and runs setup

set -euo pipefail

# dotfiles function (replaces alias)
dotfiles() {
    git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"
}

# Run system commands as root only when needed: no prefix when already root,
# sudo when available. bootstrap runs as a single file before the repo is
# checked out, so it can't source script/lib; this is inlined (setup-ubuntu
# has its own copy).
if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
elif command -v sudo &>/dev/null; then
    SUDO="sudo"
else
    SUDO=""
    echo "⚠️  Not running as root and 'sudo' not found; package installation may fail." >&2
fi
maybe_sudo() {
    if [ -n "$SUDO" ]; then "$SUDO" "$@"; else "$@"; fi
}

# Install git if needed
_install_git() {
    # macOS: /usr/bin/git is a Command Line Tools stub that exists even when CLT
    # is not installed, so `command -v git` always succeeds. Check the real CLT
    # path instead, otherwise the install flow below becomes dead code and the
    # later `git clone` triggers a GUI prompt and fails on a truly fresh Mac.
    if [[ "$OSTYPE" == "darwin"* ]]; then
        if xcode-select -p &>/dev/null && command -v git &>/dev/null; then
            echo "✅ Git already installed (Xcode CLT present)"
            return 0
        fi

        echo "Installing Xcode Command Line Tools (includes Git)..."
        xcode-select --install 2>/dev/null || true
        echo "⏳ Please complete the Xcode CLT installation dialog, then press Enter..."
        if [[ -r /dev/tty ]]; then
            read -r < /dev/tty
        fi
        if xcode-select -p &>/dev/null && command -v git &>/dev/null; then
            echo "✅ Git installed via Xcode CLT"
            return 0
        else
            echo "❌ Git still not found. Please install Xcode CLT manually and try again."
            exit 1
        fi
    fi

    # Non-macOS: a real git on PATH is sufficient
    if command -v git &>/dev/null; then
        echo "✅ Git already installed"
        return 0
    fi

    # Linux: install git using apt
    if command -v apt-get &>/dev/null; then
        echo "Installing Git..."
        maybe_sudo apt-get update
        maybe_sudo apt-get install -y git
        echo "✅ Git installed"
        return 0
    fi

    # Error: no git and no supported package manager
    echo "❌ Git not found and package manager not supported for automatic installation"
    echo "Please install git manually and try again"
    exit 1
}

_clone_dotfiles() {
    local dotfiles_dir="$HOME/.dotfiles"

    if [ ! -d "$dotfiles_dir" ]; then
        echo "Cloning dotfiles repository..."
        if git clone --bare https://github.com/hsin19/dotfiles.git "$dotfiles_dir"; then
            echo "✅ Dotfiles repository cloned successfully"
        else
            echo "❌ Failed to clone dotfiles repository"
            exit 1
        fi
    else
        echo "✅ Dotfiles repository already exists"
    fi

    dotfiles config --local status.showUntrackedFiles no

    # A bare clone has no fetch refspec, branch tracking, or reconcile strategy,
    # so `dotfiles pull` fatals ("Need to specify how to reconcile divergent
    # branches") the moment local and remote history diverge — leaving every
    # `dotfilesup` stuck. Configure them so updates keep working. These live in
    # .dotfiles/config and never touch the tracked $HOME work-tree.
    local default_branch
    default_branch=$(dotfiles symbolic-ref --short HEAD 2>/dev/null || echo "master")
    dotfiles config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    dotfiles config "branch.${default_branch}.remote" origin
    dotfiles config "branch.${default_branch}.merge" "refs/heads/${default_branch}"
    # Replay local commits on top of remote on pull, instead of a merge commit.
    dotfiles config pull.rebase true
    # Populate remote-tracking refs so the branch tracking above resolves.
    dotfiles fetch origin --quiet 2>/dev/null || true
}

_handle_conflicts() {
    local operation="$1"
    local output="$2"
    local backup_dir="$HOME/config-backup"

    local operation_backup_dir
    operation_backup_dir="$backup_dir/$operation-conflicts-$(date +%Y%m%d_%H%M%S)"
    # Note: the backup dir is created lazily on the first real conflict (via the
    # `mkdir -p "$(dirname "$dst")"` below), so a no-conflict run leaves no empty
    # timestamped directory behind in ~/config-backup.

    local found=0
    while IFS= read -r raw; do
        line="${raw#"${raw%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [ -z "$line" ] && continue

        case "$line" in
            error:*|fatal:*|warning:*|hint:*|Please*|Aborting*|From*|Updating*|"* branch "*|"* -> "*)
                continue
                ;;
        esac

        line="${line#./}"

        src=""
        if [ -e "$HOME/$line" ] || [ -L "$HOME/$line" ]; then
            src="$HOME/$line"
        else
            continue
        fi

        found=1
        dst="$operation_backup_dir/$line"
        mkdir -p "$(dirname "$dst")"
        mv -- "$src" "$dst"
        echo "ℹ️  Backed up: $line"
    done <<< "$output"

    if [ "$found" -eq 1 ]; then
        return 0
    else
        echo "⚠️ No conflicts found"
        return 1
    fi
}

_checkout_dotfiles() {
    echo "Attempting dotfiles checkout..."

    if ! checkout_output=$(dotfiles checkout 2>&1); then
        if _handle_conflicts "checkout" "$checkout_output"; then
            if dotfiles checkout; then
                echo "✅ Dotfiles checked out successfully (conflicts backed up)"
            else
                echo "❌ Dotfiles checkout failed"
                exit 1
            fi
        else
            # Failure was not a backable file conflict (corrupt repo, bad
            # permissions, stale index.lock, ...). Surface the real git error
            # and stop — never fall through and report success on an empty $HOME.
            echo "❌ Dotfiles checkout failed:" >&2
            echo "$checkout_output" >&2
            exit 1
        fi
    else
        echo "✅ Dotfiles checked out successfully"
    fi

    # Pull latest changes
    echo "Pulling latest dotfiles updates..."
    if ! pull_output=$(dotfiles pull 2>&1); then
        # Check if it's a merge conflict
        if echo "$pull_output" | grep -q "would be overwritten\|Merge conflict"; then
            if _handle_conflicts "pull" "$pull_output"; then
                # Reset and pull again
                dotfiles reset --hard HEAD
                if dotfiles pull; then
                    echo "✅ Dotfiles updated to latest version (conflicts backed up)"
                else
                    echo "⚠️ Still failed to pull updates after reset" >&2
                    exit 1
                fi
            else
                # A real merge/rebase conflict: the CONFLICT / Auto-merging lines
                # don't map to $HOME paths, so nothing was backed up and the
                # work-tree is mid-merge (conflict markers + MERGE_HEAD). Abort
                # so $HOME is left clean, then fail loudly.
                echo "❌ Failed to pull updates (unresolved merge conflict):" >&2
                echo "$pull_output" >&2
                dotfiles merge --abort 2>/dev/null || dotfiles rebase --abort 2>/dev/null || true
                exit 1
            fi
        else
            # Non-conflict failure (network, diverged history that even
            # pull.rebase can't reconcile, ...). Don't silently keep the old
            # version and report success.
            echo "⚠️ Failed to pull latest updates:" >&2
            echo "$pull_output" >&2
            exit 1
        fi
    else
        echo "✅ Dotfiles updated to latest version"
    fi
}

main() {
    echo "🚀 Starting dotfiles bootstrap..."

    _install_git
    _clone_dotfiles
    _checkout_dotfiles

    echo "✅ Dotfiles bootstrap completed successfully!"

    # Check for -y or --yes argument
    local run_setup=false
    for arg in "$@"; do
        if [[ "$arg" == "-y" || "$arg" == "--yes" ]]; then
            run_setup=true
            break
        fi
    done

    # If setup not requested, ask the user
    if [ "$run_setup" = false ]; then
        # Use /dev/tty (not stdin) so the prompt works under the documented
        # `curl -fsSL ... | bash` usage, where stdin is the pipe, not a terminal.
        if [[ -r /dev/tty ]]; then
            echo ""
            read -p "Do you want to run the full setup script now? (y/N) " -n 1 -r < /dev/tty || true
            echo ""
            if [[ ${REPLY:-} =~ ^[Yy]$ ]]; then
                run_setup=true
            fi
        else
            echo "Skipping setup script (non-interactive mode). Run 'script/setup' manually to complete installation."
        fi
    fi

    if [ "$run_setup" = true ]; then
        echo "Running setup script..."
        if [ -f "$HOME/script/setup" ]; then
            bash "$HOME/script/setup"
        else
            echo "❌ Setup script not found at $HOME/script/setup" >&2
            exit 1
        fi
    fi
}

main "$@"
