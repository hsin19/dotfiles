#!/usr/bin/env bash
# Antigravity CLI status line: maps its stdin JSON into the shape lib/statusline.sh renders.

source "$(dirname "${BASH_SOURCE[0]}")/lib/statusline.sh"

# Quota buckets -> S (short/session) and W (weekly). Prefer buckets matching the
# active model family (gemini/claude); otherwise pick the highest usage per window.
# shellcheck disable=SC2016  # $effort etc. are jq variables, not shell
statusline_main '
  (.model.effort // .effort.level) as $effort
  # display_name repeats the effort as "(Medium)" etc.; drop it since effort is shown separately
  | (.model.display_name // "Antigravity"
     | if ($effort // "") != "" then sub("[[:space:]]*\\((Low|Medium|High|XHigh|Max)\\)$"; ""; "i") else . end
    ) as $model
  | ($model | ascii_downcase
     | if contains("claude") then "claude" elif contains("gemini") then "gemini" else "" end
    ) as $fam
  | def is_short:
      (.key | ascii_downcase | test("5h|5_h|five|session|short|hour|daily"))
      or ((.value.reset_in_seconds // 999999) <= 21600);
    def pick:
      if length == 0 then null
      else
        map(select($fam != "" and (.key | ascii_downcase | contains($fam)))) as $matched
        | (if ($matched | length) > 0 then $matched else . end)
        | max_by(1 - (.value.remaining_fraction // 1))
      end;
    def used_pct:
      if . == null then null
      else (1 - .value.remaining_fraction) * 100 | if . < 0 then 0 elif . > 100 then 100 else . end
      end;
    ((.quota // {}) | to_entries
      | map(select((.value.disabled // false) != true and .value.remaining_fraction != null))
    ) as $entries
  | ($entries | map(select(is_short)) | pick) as $s
  | ($entries | map(select(is_short | not)) | pick) as $w
  | {
      model: $model,
      effort: $effort,
      short_pct: ($s | used_pct),
      short_reset: $s.value.reset_in_seconds,
      week_pct: ($w | used_pct),
      week_reset: $w.value.reset_in_seconds
    }
'
