#!/bin/bash

# Development environment setup script (Unified Entry Point)
# Usage: ./setup
# Detects OS and runs appropriate platform-specific setup, then common configurations

set -euo pipefail

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source library modules
source "$SCRIPT_DIR/lib/env-loader.sh"
source "$SCRIPT_DIR/lib/os-detect.sh"

echo "🚀 Development Environment Setup"
echo "=================================="

# ============================================================================
# Shared Setup Functions (Cross-platform)
# ============================================================================

_setup_git_identities() {
    echo "Setting up Git identities..."

    # --- Global Git Config ---
    if [ -n "${GIT_USER_NAME:-}" ]; then
        git config --global user.name "$GIT_USER_NAME"
    fi

    if [ -n "${GIT_USER_EMAIL:-}" ]; then
        git config --global user.email "$GIT_USER_EMAIL"
    fi

    if [ -n "${GIT_SSH_SIGNING_KEY:-}" ]; then
        local signing_key_path="${GIT_SSH_SIGNING_KEY/#\~/$HOME}"

        if [ -f "$signing_key_path" ]; then
            echo "Setting up Git SSH signing with key: $signing_key_path"
            git config --global gpg.format ssh
            git config --global user.signingkey "$signing_key_path"
            git config --global commit.gpgsign true
        else
            echo "⚠️  GIT_SSH_SIGNING_KEY provided but file not found: $GIT_SSH_SIGNING_KEY"
            echo "   (Expanded path: $signing_key_path)"
            echo "   Skipping SSH signing configuration."
        fi
    fi

    # --- Git Aliases ---
    echo "Setting up Git aliases..."
    git config --global alias.ai-commit "!bash $HOME/script/ai-commit"
    git config --global alias.ccc "!bash $HOME/script/ai-commit"
    git config --global alias.setup-hook "!bash $HOME/script/setup-git-hook"
    git config --global alias.sss "!bash $HOME/script/setup-git-hook"
    echo "✅ Git aliases setup completed!"

    # --- Global Git Ignore ---
    echo "Setting up global Git ignore..."
    local global_gitignore="$HOME/.gitignore_global"
    git config --global core.excludesfile "$global_gitignore"
    echo "✅ Configured global gitignore to use $global_gitignore"

    # --- Git Defaults ---
    echo "Setting up Git defaults..."
    git config --global init.defaultBranch main
    # Drop remote-tracking refs of branches deleted on the remote (such as a merged PR's) on every fetch.
    git config --global fetch.prune true
    # A new branch's first push sets its upstream, without -u.
    git config --global push.autoSetupRemote true
    # Pull rebases instead of making a merge commit, stashing uncommitted changes around it.
    git config --global pull.rebase true
    git config --global rebase.autoStash true
    # Conflicts show the common ancestor too, and a resolution is replayed when the same conflict comes back.
    git config --global merge.conflictStyle zdiff3
    git config --global rerere.enabled true
    git config --global diff.algorithm histogram
    # `git branch` lists the most recently committed-to branches first.
    git config --global branch.sort -committerdate
    echo "✅ Git defaults setup completed!"

    # --- Per-directory Git Config ---
    _setup_git_workspace() {
        local workspace_name="$1"

        if [ -z "$workspace_name" ]; then
            echo "❌ Workspace name is required"
            return 1
        fi

        if [[ ! "$workspace_name" =~ ^[a-zA-Z0-9]+$ ]]; then
            echo "❌ Invalid workspace name: '$workspace_name'"
            echo "   Workspace names must contain only: a-z, A-Z, 0-9"
            return 1
        fi

        echo "Setting up workspace: $workspace_name..."
        local workspace_dir="$HOME/repos/$workspace_name"
        mkdir -p "$workspace_dir"

        # workspace git config
        local config_file="$workspace_dir/.gitconfig"
        git config --global includeIf."gitdir:$workspace_dir/".path "$config_file"

        if [ ! -f "$config_file" ]; then
            touch "$config_file"
        fi

        # git email config
        local email_var="GIT_WORKSPACE_${workspace_name}_EMAIL"
        local workspace_email="${!email_var:-}"

        if [ -n "$workspace_email" ]; then
            git config -f "$config_file" user.email "$workspace_email"
        fi

        # nuget config
        local nuget_var="GIT_WORKSPACE_${workspace_name}_NUGET_URL"
        local workspace_nuget_url="${!nuget_var:-}"

        if [ -n "$workspace_nuget_url" ]; then
            local nuget_config="$workspace_dir/NuGet.config"
            if [ -f "$nuget_config" ]; then
                echo "⚠️  $nuget_config already exists, skipping..."
            else
                cat <<-EOF > "$nuget_config"
<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="$workspace_name" value="$workspace_nuget_url" protocolVersion="3" />
    </packageSources>
</configuration>
EOF
            fi
        fi
    }

    # Load workspaces from env
    if [ -n "${GIT_WORKSPACES:-}" ]; then
        for workspace in ${GIT_WORKSPACES}; do
            _setup_git_workspace "$workspace"
        done
    fi

    echo "✅ Git identities setup completed!"
}

_setup_zsh() {
    echo "Setting up Oh My Zsh and plugins..."

    # Check if Zsh is installed
    if ! command -v zsh &>/dev/null; then
        echo "⚠️  Zsh is not installed. It should have been installed by the platform setup."
        return 1
    fi

    # Install Oh My Zsh if it's not already installed. Check for the actual
    # entrypoint file, not just the directory: a failed installer can leave a
    # bare ~/.oh-my-zsh behind (created as a side effect of cloning the custom
    # plugins below into it), which a directory check would mistake for a
    # complete install — so OMZ would never be retried on re-run.
    if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
        echo "Installing Oh My Zsh..."
        # Download first and check the exit code. `sh -c "$(curl ...)"` swallows
        # curl failures: on error the substitution is empty and `sh -c ""`
        # exits 0, which set -e cannot catch.
        local omz_installer
        if ! omz_installer=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh); then
            echo "❌ Failed to download Oh My Zsh installer"
            return 1
        fi
        # --keep-zshrc: do NOT overwrite the repo's tracked ~/.zshrc with the OMZ
        # template (which would silently disable Powerlevel10k, fnm lazy-load,
        # etc.); --unattended alone would overwrite it without even prompting.
        sh -c "$omz_installer" "" --unattended --keep-zshrc
    else
        echo "✅ Oh My Zsh is already installed."
    fi

    # Define the custom path for plugins and themes
    ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

    # Helper function to clone a git repo if the destination directory doesn't exist
    _clone_if_not_exists() {
        local repo_url="$1"
        local dest_path="$2"
        local name="$3"
        if [ ! -d "$dest_path" ]; then
            echo "Installing $name..."
            git clone --depth=1 "$repo_url" "$dest_path"
        else
            echo "✅ $name is already installed."
        fi
    }

    # Install theme and plugins
    _clone_if_not_exists "https://github.com/romkatv/powerlevel10k.git" "${ZSH_CUSTOM}/themes/powerlevel10k" "Powerlevel10k theme"
    _clone_if_not_exists "https://github.com/zsh-users/zsh-syntax-highlighting.git" "${ZSH_CUSTOM}/plugins/zsh-syntax-highlighting" "zsh-syntax-highlighting plugin"
    _clone_if_not_exists "https://github.com/zsh-users/zsh-autosuggestions.git" "${ZSH_CUSTOM}/plugins/zsh-autosuggestions" "zsh-autosuggestions plugin"
    _clone_if_not_exists "https://github.com/TamCore/autoupdate-oh-my-zsh-plugins.git" "${ZSH_CUSTOM}/plugins/autoupdate" "autoupdate-oh-my-zsh-plugins"

    echo "✅ Oh My Zsh and plugins installed."
}

_setup_node() {
    echo "Setting up Node.js (via fnm)..."

    if ! command -v fnm &> /dev/null; then
        echo "⚠️  fnm not found, cannot install Node.js. Skipping."
        return 1
    fi

    # fnm is the single source of truth for Node (no brew/system node).
    eval "$(fnm env)"

    # Check fnm's own default alias, not `command -v node`: any leftover system
    # or brew node on PATH would short-circuit the install and leave fnm's
    # aliases/default (which .zshrc relies on to put node on the interactive
    # PATH) unbuilt — contradicting "fnm is the single source of truth".
    local fnm_default="${FNM_DIR:-$HOME/.local/share/fnm}/aliases/default"
    if [ ! -d "$fnm_default" ]; then
        echo "Installing Node.js LTS via fnm..."
        fnm install --lts
        fnm default lts-latest
        eval "$(fnm env)"
    else
        echo "✅ Node.js already installed ($(node --version 2>/dev/null || echo 'via fnm'))"
    fi
}

_setup_pnpm() {
    echo "Setting up pnpm..."

    # pnpm is installed into the fnm-managed default Node, so load fnm's env.
    if command -v fnm &> /dev/null; then
        eval "$(fnm env)"
    fi

    if ! command -v npm &> /dev/null; then
        echo "⚠️  npm not found (Node.js missing). Skipping."
        return 0
    fi

    # Node.js 25+ no longer bundles corepack, so pnpm is a global npm install.
    # pnpm still runs the version each project pins in packageManager.
    # --allow-scripts lets its install script swap in the native binary.
    if command -v pnpm &> /dev/null; then
        echo "✅ pnpm already installed ($(pnpm --version 2>/dev/null))"
    elif npm install --global --allow-scripts=pnpm pnpm@latest >/dev/null; then
        echo "✅ Installed pnpm $(pnpm --version 2>/dev/null)"
    else
        echo "⚠️  npm install -g pnpm failed. Skipping."
        return 0
    fi

    # zsh ships a built-in _npm completion but not _pnpm. Pre-generate pnpm's
    # zsh completion to a cache file so .zshrc can load it cheaply at startup.
    local comp_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
    mkdir -p "$comp_dir"
    local comp_file="$comp_dir/pnpm-completion.zsh"
    # Verify the output really is a completion script (#compdef header), so
    # stray warnings don't get cached as a broken file.
    if pnpm completion zsh > "$comp_file" 2>/dev/null && grep -q '#compdef' "$comp_file"; then
        echo "✅ Generated pnpm zsh completion → $comp_file"
    else
        echo "⚠️  Failed to generate pnpm completion. Skipping."
        rm -f "$comp_file"
    fi
}

# Set .statusLine in a CLI's settings.json without overwriting machine-local keys
# (permissions, model, trustedWorkspaces, etc.).
# Usage: _configure_statusline <label> <settings_file> <statusLine JSON>
_configure_statusline() {
    local label="$1" settings_file="$2" status_line="$3"
    local tmp_file

    if ! command -v jq &>/dev/null; then
        echo "⚠️  jq not found; skipping $label statusLine configuration."
        return 0
    fi

    mkdir -p "$(dirname "$settings_file")"
    if [ ! -f "$settings_file" ]; then
        echo '{}' > "$settings_file"
    fi
    tmp_file=$(mktemp)
    if jq --argjson sl "$status_line" '.statusLine = $sl' "$settings_file" > "$tmp_file"; then
        mv "$tmp_file" "$settings_file"
        echo "✅ Configured $label statusLine → $(jq -r '.command' <<<"$status_line")"
    else
        rm -f "$tmp_file"
        echo "⚠️  Failed to update $settings_file (invalid JSON?); skipping statusLine config."
    fi
}

_setup_claude_cli() {
    echo "Setting up Claude Code CLI..."

    # Ensure ~/.local/bin is in PATH for the setup script context
    if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
        export PATH="$HOME/.local/bin:$PATH"
    fi

    if command -v claude &>/dev/null; then
        echo "✅ Claude Code CLI (claude) is already installed."
    else
        echo "Installing Claude Code CLI..."
        curl -fsSL https://claude.ai/install.sh | bash
    fi

    _configure_statusline "Claude Code CLI" "$HOME/.claude/settings.json" \
        '{"type": "command", "command": "bash ~/script/claude-statusline"}'
}

_setup_antigravity_cli() {
    echo "Setting up Antigravity CLI..."

    # Ensure ~/.local/bin is in PATH for the setup script context
    if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
        export PATH="$HOME/.local/bin:$PATH"
    fi

    if command -v agy &>/dev/null; then
        echo "✅ Antigravity CLI (agy) is already installed."
    else
        echo "Installing Antigravity CLI..."
        curl -fsSL https://antigravity.google/cli/install.sh | bash
    fi

    _configure_statusline "Antigravity CLI" "$HOME/.gemini/antigravity-cli/settings.json" \
        '{"type": "command", "command": "bash ~/script/agy-statusline", "enabled": true}'
}

_setup_codex_statusline() {
    # Codex renders its status line itself (there is no external command hook).
    # Keep the same useful signals as the Claude/Agy lines while letting the TUI
    # update context and account-limit values directly.
    local settings_file="$HOME/.codex/config.toml"
    local tmp_file
    local status_line='status_line = ["project-name", "git-branch", "model", "reasoning", "context-used", "five-hour-limit", "weekly-limit", "thread-name"]'

    mkdir -p "$(dirname "$settings_file")"
    if [ ! -f "$settings_file" ]; then
        printf '%s\n' '[tui]' "$status_line" 'status_line_use_colors = true' > "$settings_file"
    elif grep -qE '^[[:space:]]*\[tui\][[:space:]]*(#.*)?$' "$settings_file"; then
        tmp_file=$(mktemp)
        # Replace only values owned by this setup while preserving all other TOML
        # sections and TUI preferences. Codex writes these entries as one-line arrays.
        awk -v status_line="$status_line" '
            /^[[:space:]]*\[tui\][[:space:]]*(#.*)?$/ {
                in_tui = 1
                print
                print status_line
                print "status_line_use_colors = true"
                next
            }
            in_tui && /^[[:space:]]*\[/ { in_tui = 0 }
            in_tui && /^[[:space:]]*(status_line|status_line_use_colors)[[:space:]]*=/ { next }
            { print }
        ' "$settings_file" > "$tmp_file"
        mv "$tmp_file" "$settings_file"
    else
        printf '\n[tui]\n%s\nstatus_line_use_colors = true\n' "$status_line" >> "$settings_file"
    fi

    echo "✅ Configured Codex CLI native status line → $settings_file"
}

# ============================================================================
# Main Execution
# ============================================================================

main() {
    local os_name
    os_name=$(detect_os)

    echo "Detected OS: $os_name"
    echo ""

    # Load environment variables
    load_env "$SCRIPT_DIR"

    # Run platform-specific setup
    if is_macos; then
        if [ -f "$SCRIPT_DIR/setup-macos" ]; then
            bash "$SCRIPT_DIR/setup-macos"
        else
            echo "❌ setup-macos not found"
            exit 1
        fi
    elif is_ubuntu; then
        if [ -f "$SCRIPT_DIR/setup-ubuntu" ]; then
            bash "$SCRIPT_DIR/setup-ubuntu"
        else
            echo "❌ setup-ubuntu not found"
            exit 1
        fi
    else
        echo "❌ Unsupported OS: $os_name"
        echo "Supported: macos, ubuntu"
        exit 1
    fi

    # Ensure Homebrew is on PATH for macOS (arm64) after platform setup
    if is_macos && [[ $(uname -m) == "arm64" ]] && [[ ":$PATH:" != *":/opt/homebrew/bin:"* ]]; then
        export PATH="/opt/homebrew/bin:$PATH"
    fi

    # Ensure fnm is on PATH and initialized after platform setup (Ubuntu)
    if is_ubuntu; then
        export PATH="$HOME/.local/share/fnm:$PATH"
        if command -v fnm &>/dev/null; then
            eval "$(fnm env)"
        fi
    fi

    echo ""
    echo "🔧 Running cross-platform setup..."
    echo ""

    # Run shared setup functions. Each step may fail without aborting the whole
    # setup: under set -e a bare `_setup_x` that returns 1 (e.g. zsh/fnm missing)
    # would kill the script mid-way with no summary, so the message ("Skipping")
    # contradicts the actual behaviour (abort). Calling each in an `if !` context
    # both suppresses that abort and lets us collect and report failures.
    local failed_steps=()
    local step
    for step in _setup_zsh _setup_git_identities _setup_node _setup_pnpm _setup_claude_cli _setup_antigravity_cli _setup_codex_statusline; do
        if ! "$step"; then
            echo "⚠️  Step failed: $step (continuing with remaining steps)"
            failed_steps+=("$step")
        fi
    done

    echo ""
    if [ ${#failed_steps[@]} -eq 0 ]; then
        echo "🎉 All done! Your development environment is ready."
    else
        echo "⚠️  Setup finished with ${#failed_steps[@]} failed step(s): ${failed_steps[*]}"
        echo "   Review the messages above and re-run 'script/setup' after fixing."
    fi
    echo ""
    echo "📝 Next steps:"
    echo "  1. Restart your terminal or run: source ~/.zshrc"
    if is_ubuntu; then
        echo "  2. If you changed default shell to zsh, log out and log back in"
    fi
}

main "$@"
